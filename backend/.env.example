# SlotSync Backend Environment Configuration
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/slotsync
JWT_SECRET=replace_with_64_character_hex_secret_generated_using_crypto
CLIENT_URL=http://localhost:5173
NODE_ENV=development
PORT=8084
GRACE_MINUTES=15
MAX_ADVANCE_DAYS=14
QUOTA_STUDENT=3
QUOTA_FACULTY=6
